.col-total { font-weight: 750; text-align: center; font-size: 16px; }
.col-acoes { white-space: nowrap; text-align: right; padding-right: 12px !important; }

.rodape-turnos { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; }

.automaticas { margin-top: 22px; }
