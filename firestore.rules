rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Troque pelo mesmo e-mail que está em firebase-config.js (ADMIN_EMAIL)
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@suaempresa.com.br";
    }

    // Cadastros: todos leem, só o administrador altera
    match /config/{docId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Escala: supervisores leem e preenchem vagas e folgas
    match /escalas/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['hubId', 'data', 'slots', 'folgas', 'atualizadoPor', 'atualizadoEm'])
        && request.resource.data.data is string
        && request.resource.data.hubId is string;
      allow delete: if ehAdmin();
    }
  }
}
